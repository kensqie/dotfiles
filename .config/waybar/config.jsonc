{
	"layer": "top",
	"position": "top",
	"height": 20,
	"spacing": 5,
	"modules-left": [
		"niri/workspaces"
	],
	"modules-center": [
		"clock"
	],
	"modules-right": [
		"group/hardware",
		"wireplumber",
		"backlight",
		"niri/language",
		"group/extray"
	],
	"group/hardware": {
		"orientation": "horizontal",
		"drawer": {
			"transition-duration": 300,
			"transition-left-to-right": false
		},
		"modules": [
			"battery",
			"disk",
			"cpu",
			"memory"
		]
	},
	"group/extray": {
		"orientation": "horizontal",
		"drawer": {
			"transition-duration": 300,
			"transition-left-to-right": false
		},
		"modules": [
			"tray",
			"custom/theme-toggle"
		]
	},
	"niri/language": {
		"format": " {short}"
	},
	"clock": {
		"format": " {:%R}",
		"format-alt": " {:%d %B %Y}",
		"tooltip-format": "{calendar}",
		"calendar": {
			"mode" : "month",
			"mode-mon-col" : 3,
			"weeks-pos" : "",
			"on-scroll" : 1,
			"format": {
				"months": "<b>{}</b>",
				"days": "{}",
				"weeks": "<b>W{}</b>",
				"weekdays": "{}",
				"today": "<b><u>{}</u></b>"
			}
		},
		"actions": {
			"on-click-right": "mode",
			"on-scroll-up": "shift_up",
			"on-scroll-down": "shift_down"
		}
	},
	"disk": {
		"interval": 30,
		"format": " {percentage_used}%",
		"path": "/"
	},
	"cpu": {
		"interval": 10,
		"format": " {usage}%",
		"max-length": 10
	},
	"memory": {
		"interval": 30,
		"format": " {percentage}%",
		"tooltip-format": "{used:0.1f}G/{total:0.1f}G"
	},
	"battery": {
		"states": {
			"good": 97,
			"warning": 30,
			"critical": 20
		},
		"format": "{icon} {capacity}%",
		"format-charging": " {capacity}%",
		"format-plugged": " {capacity}%",
		"format-alt": "{icon} {time}",
		"format-good": " {capacity}%",
		"format-full": " {capacity}%",
		"format-icons": [
			"",
			"",
			"",
			"",
			""
		]
	},
	"wireplumber": {
		"format": "{icon} {volume}%",
		"format-bluetooth": "{icon} {volume}%",
		"format-muted": " {volume}%",
		"format-icons": {
			"headphone": "",
			"hands-free": "",
			"headset": "",
			"phone": "",
			"portable": "",
			"car": "",
			"default": [
				"",
				""
			]
		},
		"scroll-step": 1,
		"on-click": "pavucontrol"
	},
	"backlight": {
		"device": "intel_backlight",
		"format": "{icon} {percent}%",
		"format-icons": [""]
	},
	"custom/theme-toggle": {
		"exec": "~/.config/waybar/scripts/theme-toggle.sh",
		"return-type": "json",
		"interval": 5,
		"on-click": "~/.config/waybar/scripts/theme-toggle.sh --toggle"
	},
	"tray": {
		"icon-size": 20,
		"spacing": 10
	}
}
