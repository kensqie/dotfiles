* {
	font-family: '{{ .appearance.font.monospace }}', '{{ .appearance.font.icons }}';
	font-size: {{ .appearance.font.panelSize }}px;
}

window#waybar {
	background-color: @bg;
	border-bottom: none;
	color: @fg;
	transition-duration: 0.2s;
	transition-property: background-color;
}

window#waybar.hidden {
	opacity: 0.2;
}

#clock,
#battery,
#cpu,
#memory,
#disk,
#temperature,
#backlight,
#network,
#pulseaudio,
#wireplumber,
#custom-media,
#tray,
#mode,
#idle_inhibitor,
#mpd,
#language,
#taskbar,
#custom-theme-toggle,
#workspaces {
	background-color: @module-bg;
	border: none;
	border-radius: 5px;
	color: @module-fg;
	padding: 2px 10px;
	margin: 5px 0;
}

#taskbar,
#workspaces {
	padding: 0;
	background-color: @surface;
	color: @fg;
}

#taskbar button,
#workspaces button {
	background-color: @module-bg;
	color: @muted-fg;
	font-weight: normal;
	text-shadow: none;
	border: none;
	box-shadow: none;
	padding: 2px 5px;
	margin-left: 5px;
}

#taskbar button:hover {
	background: @module-fg;
	color: @module-bg;
}

#workspaces,
#workspaces button {
	transition: background-color 0.2s ease, color 0.2s ease;
}

#workspaces button:hover {
	background: @module-bg;
	color: @module-fg;
}

#workspaces button.focused {
	background-color: @module-bg;
	color: @module-fg;
}

#workspaces button.urgent,
#mode {
	background-color: @critical;
	color: @critical-fg;
}

.modules-left > widget:first-child > #workspaces {
	margin-left: 0;
}

.modules-right > widget:last-child > #workspaces {
	margin-left: 0;
}

#battery,
#battery.charging,
#battery.plugged {
	color: @module-fg;
}

@keyframes blink {
	to {
		background-color: @fg;
		color: @surface;
	}
}

#battery.critical:not(.charging) {
	animation-direction: alternate;
	animation-duration: 0.5s;
	animation-iteration-count: infinite;
	animation-name: blink;
	animation-timing-function: linear;
	color: @fg;
}

label:focus {
	background-color: @surface;
}

#tray {
	margin-right: 5px;
}

#tray > .passive {
	-gtk-icon-effect: dim;
}

#tray > .needs-attention {
	background-color: @critical;
	-gtk-icon-effect: highlight;
}

#idle_inhibitor.activated {
	background-color: @fg;
	color: @surface;
}

#hardware #disk,
#hardware #cpu,
#hardware #memory {
	margin-right: 5px;
}

#extray #custom-theme-toggle {
	margin-right: 5px;
}
